{
  "name": "caloriepunch",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "APP_VARIANT=development npx expo start -c",
    "build:sim:ios": "eas build --platform ios --profile ios-simulator",
    "build:dev:ios": "eas build --platform ios --profile development",
    "build:dev:android": "eas build --platform android --profile development",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:prod:ios": "eas build --platform ios --profile production --auto-submit",
    "build:prod:android": "eas build --platform android --profile production",
    "update:dev": "eas update --branch development",
    "update:preview": "eas update --branch preview",
    "update:prod": "eas update --branch production",
    "submit:prod:ios": "eas submit --platform ios --profile production",
    "test": "jest --watchAll",
    "lint": "eslint .",
    "lintFixAll": "eslint '**/*.{js,jsx}' --fix",
    "prettierFixAll": "prettier --write '**/*.{js,jsx}'",
    "fix:lintPrettier": "yarn prettierFixAll && yarn lintFixAll"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "dotenv": "^17.2.2",
    "eas-cli": "^16.12.0",
    "expo": "~52.0.38",
    "expo-audio": "~0.3.5",
    "expo-blur": "~14.0.3",
    "expo-constants": "~17.0.4",
    "expo-dev-client": "~5.0.14",
    "expo-font": "~13.0.3",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.19",
    "expo-speech-recognition": "^2.1.4",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~2.0.1",
    "expo-symbols": "~0.2.2",
    "expo-system-ui": "~4.0.8",
    "expo-updates": "~0.27.3",
    "expo-web-browser": "~14.0.2",
    "nativewind": "^4.1.23",
    "openai": "^5.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-chart-kit": "^6.12.0",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "^15.11.2",
    "react-native-vector-icons": "^10.2.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^15.14.0",
    "jest": "^29.2.1",
    "jest-expo": "~52.0.6",
    "prettier": "^3.4.2",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.21.0"
  },
  "private": true
}
